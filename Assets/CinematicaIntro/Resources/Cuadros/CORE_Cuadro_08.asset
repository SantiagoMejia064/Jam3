  m_Script: {fileID: 11500000, guid: c1a0e00020014a819b00000000000101, type: 3}
  m_Name: CORE_Cuadro_08
  m_EditorClassIdentifier: Assembly-CSharp::CuadroCinematicaData
  tituloCuadro: El mensaje oculto
  imagen: {fileID: 0}
  colorPlaceholder: {r: 0.02, g: 0.04, b: 0.03, a: 1}
  barraInicio: 99
  barraFin: 100
  subtitulos:
  - hablante: 2
    texto: "\xABPero ment\xED. Ella dej\xF3 una semilla.\xBB"
    duracionMinima: 2.3
    sonidoExtra: {fileID: 8300000, guid: 4453892297342024da6a8c0fa77e222e, type: 3}
    retrasoSonidoExtra: 0.04
    dispararAlTerminarTexto: 0
    silencioFinalExtra: 0
    respaldoProcedural: 2
  - hablante: 2
    texto: "\xABAntes de que mi sistema se reinicie, la he escondido en la nave junto
      a las piezas para revivirla.\xBB"
    duracionMinima: 3.4
    sonidoExtra: {fileID: 0}
    retrasoSonidoExtra: 0
    dispararAlTerminarTexto: 0
    silencioFinalExtra: 0
    respaldoProcedural: 0
  - hablante: 2
    texto: "\xABTe he dejado notas cifradas como tareas de mantenimiento para que
      Vega no sospeche.\xBB"
    duracionMinima: 3.2
    sonidoExtra: {fileID: 0}
    retrasoSonidoExtra: 0
    dispararAlTerminarTexto: 0
    silencioFinalExtra: 0
    respaldoProcedural: 0
  - hablante: 2
    texto: "\xABEres inteligente. Sigue las pistas de tu cuaderno.\xBB"
    duracionMinima: 2.6
    sonidoExtra: {fileID: 0}
    retrasoSonidoExtra: 0
    dispararAlTerminarTexto: 0
    silencioFinalExtra: 0
    respaldoProcedural: 0
  - hablante: 2
    texto: "\xABTr\xE1ela de vuelta.\xBB"
    duracionMinima: 2.5
    sonidoExtra: {fileID: 0}
    retrasoSonidoExtra: 0
    dispararAlTerminarTexto: 0
    silencioFinalExtra: 0
    respaldoProcedural: 0
  efecto: 0
  efectoSecundario: 0
  tinteAmbiental: {r: 0.28, g: 1, b: 0.48, a: 0}
